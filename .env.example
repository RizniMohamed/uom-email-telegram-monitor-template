## Template only: keep this file free of real credentials.
## On Android copy it to ~/.local/share/uom-monitor/monitor.env and edit there.
UOM_IMAP_HOST=mail.uom.lk
UOM_IMAP_PORT=993
# Your own university IMAP login (use the same username accepted by your mail service).
UOM_USERNAME=
# Quote passwords containing spaces or #. ${...} remains literal.
UOM_PASSWORD=
# Create your own bot using Telegram's verified @BotFather.
TELEGRAM_BOT_TOKEN=
# Numeric destination ID; group IDs may be negative.
TELEGRAM_CHAT_ID=
CHECK_INTERVAL=30
RETRY_INTERVAL=30
# Relative to the private monitor.env directory; the Termux manager also forces this path.
# Never delete/reset an existing checkpoint to fix an error.
UOM_STATE_FILE=./uom_monitor_state.json
# Optional: set UOM_ENV_FILE externally to select a different .env file.
